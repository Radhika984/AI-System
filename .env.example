# Copy to .env (gitignored) and fill in. NEVER commit .env.
# Only Google AI Studio free tier is used. Budget: zero. No billing account required.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Free-tier models (verified on ai.google.dev pricing page, 2026-11-11).
# Free tier = 20 requests/day/model (observed from a 429 QuotaFailure), so roles are
# spread across models and questions are batched.
SOLVER_A_MODEL=gemini-3-flash-preview
SOLVER_B_MODEL=gemini-3.1-flash-lite
JUDGE_MODEL=gemini-3-flash-preview
# Pace requests to stay under free-tier RPM (seconds between calls)
LLM_MIN_INTERVAL_S=6
LLM_TIMEOUT_S=300
LLM_MAX_RETRIES=5
# Set to 1 to forbid any network LLM call (cache-only replay)
LLM_OFFLINE=0

# API server
CORS_ORIGINS=http://localhost:5173
STATE_DIR=state
SOLVER_BATCH_SIZE=10
JUDGE_BATCH_SIZE=4

# Faculty-console write protection (set on the server only; never commit real values).
# REVIEWER_PASSCODE: shared passcode required for approve/edit/reject. Unset = actions disabled.
REVIEWER_PASSCODE=
# ADMIN_RESET_TOKEN: separate token for POST /api/admin/reset (restore clean demo state).
# Unset = the reset endpoint does not exist. Must differ from REVIEWER_PASSCODE.
ADMIN_RESET_TOKEN=
