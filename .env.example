# Copy to .env (gitignored) and fill in. NEVER commit .env.
# Only Google AI Studio free tier is used. Budget: zero. No billing account required.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Free-tier models (verified on ai.google.dev pricing page, 2026-11-11)
SOLVER_A_MODEL=gemini-3.8-flash
SOLVER_B_MODEL=gemini-3.6-flash
JUDGE_MODEL=gemini-3.8-flash
FALLBACK_MODEL=gemini-3.1-flash-lite
# Pace requests to stay under free-tier RPM (seconds between calls)
LLM_MIN_INTERVAL_S=6
LLM_TIMEOUT_S=90
LLM_MAX_RETRIES=5
# Set to 1 to forbid any network LLM call (cache-only replay)
LLM_OFFLINE=0

# API server
CORS_ORIGINS=http://localhost:5173
STATE_DIR=state
